#!/bin/bash
set -eu

{{ if eq .chezmoi.os "darwin" -}}
# Install Homebrew if missing
if ! command -v brew &>/dev/null; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
fi

echo "Installing Homebrew packages..."
brew bundle --file=/dev/stdin <<EOF
brew "antidote"
brew "ansible"
brew "bat"
brew "btop"
brew "coreutils"
brew "curl"
brew "direnv"
brew "diskus"
brew "eza"
brew "fd"
brew "findutils"
brew "fish"
brew "fortune"
brew "fzf"
brew "gh"
brew "git"
brew "git-delta"
brew "gnu-sed"
brew "gnupg"
brew "ghostscript"
brew "hexyl"
brew "highlight"
brew "htop"
brew "lazygit"
brew "ncdu"
{{ if not .headless }}brew "macvim"
{{ end -}}
brew "nmap"
brew "neovim"
brew "noti"
brew "openssl"
{{ if not .headless }}brew "pinentry-mac"
{{ end -}}
brew "ponysay"
brew "prettyping"
brew "python"
brew "reattach-to-user-namespace"
brew "ripgrep"
brew "starship"
brew "tree"
brew "tree-sitter-cli"
brew "tmux"
brew "tlrc"
brew "universal-ctags"
brew "watch"
brew "wget"
brew "xsv"
brew "zoxide"
brew "zsh"

{{ if not .headless -}}
cask "font-hack"
cask "font-meslo-for-powerline"
cask "font-menlo-for-powerline"
cask "rectangle"
{{ end -}}
EOF

{{ else if eq .chezmoi.os "linux" -}}
echo "Installing packages..."
sudo apt-get update -qq
sudo apt-get install -y \
    bash curl direnv fish fzf git gnupg ghostscript highlight htop neovim nmap pinentry-curses python3 ripgrep tmux tree universal-ctags vim wget zsh

# These may not be available on all distros
sudo apt-get install -y bat eza hexyl 2>/dev/null || true
sudo apt-get install -y diskus fd-find 2>/dev/null || true
sudo apt-get install -y tree-sitter-cli 2>/dev/null || true
sudo apt-get install -y lazygit 2>/dev/null || true

{{ end -}}

[user]
	name = {{ .name }}
	email = {{ .email }}
	signingkey = {{ .signingkey }}
	logallrefupdates=true
[core]
	editor = {{ if lookPath "nvim" }}nvim{{ else }}vim{{ end }}
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes
	autocrlf = input
	pager = delta
[commit]
	gpgsign = {{ if .signingkey }}true{{ else }}false{{ end }}
[credential]
{{ if eq .chezmoi.os "darwin" -}}
	helper = osxkeychain
{{ else -}}
	helper = cache --timeout=360000
{{ end -}}
[push]
	default = current
[color]
	ui = always
	diff = true
	branch = true
	pager = true
	status = true
[grep]
	linenumber = true
[status]
	relativePaths=true
[i18n]
	commitencoding = utf-8

[sendemail]
	from = {{ .name }} <{{ .email }}>
	smtpserver = smtp.gmail.com
	smtpuser = {{ .email }}
	smtpencryption = tls
	smtppass =
	chainreplyto = false
	smtpserverport = 587

[url "git@github.com:"]
	insteadOf = g:
[url "git://github.com/"]
	insteadOf = gh:

### Diff ###
[diff]
	indentHeuristic = true
[diff "nodiff"]
	# .gitattributes assigns diff=nodiff to binary types; print nothing
	command = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
[merge]
	conflictStyle = zdiff3


[alias]
	;commit = commit -S
	changelog = log --pretty=format:\" * %s\"
	changes = log --pretty=format:\"%h %cr %cn %Cgreen%s%Creset\" --name-status
	c = commit
	ca = commit -a
#	commitme = commit --author="Shubham Chaudhary <me@shubhamchaudhary.in>"
	currentbranch = rev-parse --abbrev-ref HEAD
	d = diff                          # diff unstaged changes
	dc = diff --cached                # diff staged changes
	diverges = !bash -c 'diff -u <(git rev-list --first-parent "${1}") <(git rev-list --first-parent "${2:-HEAD}") | sed -ne \"s/^ //p\" | head -1' -
	filelog = log -u                  # show changes to a file
	gl  = log -12 --color=always --all --graph --topo-order --pretty='format:%Cgreen%h%Creset %s %C(black bold)(by %an)%Creset%C(yellow bold)%d%Creset%n'
	gll = log     --color=always --all --graph --topo-order --pretty='format:%Cgreen%h%Creset %s %C(black bold)(%cr by %an)%Creset%C(yellow bold)%d%Creset%n'
	ignored = ls-files -ci --exclude-standard
	join = merge --no-ff
#	l   = log -18 --graph --color=always --all --topo-order --pretty='format:%Cgreen%h%Creset %s%Cred%d%Creset %C(black bold)(by %an)%Creset'
#	l   = log -18 --graph --color=always --all --topo-order --pretty='format:%Cgreen%h%Creset %s%Cred%d%Creset %C(black bold)(by %an)%Creset'
	;l   = log --oneline --graph --decorate --topo-order --pretty='format:%C(yellow)%h%Creset %s%C(auto)%d%Creset %C(cyan bold)(by %an)%Creset'
	l = log --oneline --graph --decorate --topo-order --pretty='format:%C(yellow)%h%Creset %s%C(auto)%d%Creset %C(cyan bold)(by %an)%Creset %cr'
	last = log -1 HEAD
	dlast = diff HEAD^                # diff last committed change
	ll  = log     --color=always --all --topo-order --pretty='format:%Cgreen%h%Creset %s%Cred%d%Creset %C(black bold)(by %an)%Creset'
	lof = log --pretty=fuller --stat --decorate --graph
	lol = log --oneline --graph --decorate
	mt = mergetool                    # fire up the merge tool
	p = push --verbose
	pull = pull --ff-only
	sa = stash apply                  # apply stash (restore changes)
	sd = stash drop                   # drop stashes (destory changes)
	short = log --pretty=format:\"%h %cr %cn %Cgreen%s%Creset\"
	shortnocolor = log --pretty=format:\"%h %cr %cn %s\"
	sl = stash list                   # list stashes
	sta = stash                       # stash changes
	stp = stash pop
	st = status -s
	uncommit = reset --soft HEAD^     # go back before last commit, with files in uncommitted state
	undo-commit = reset --soft HEAD^
	unstage = reset HEAD --
#	unstage = reset HEAD              # remove files from index (tracking)
	up = merge --ff-only
	wdiff = diff
#funny
	bah = blame
	eh = config --get-regexp alias
	find = grep
	found = stash pop
	fuckedup = reset --hard
	huh = diff
	in = add
	lost = stash
	m = checkout main
	meow = status
	out = rm
	overit = stash clear
	real = rebase
	that = checkout -
	this = checkout
	wasted = reset HEAD
	what = diff
	with = merge
	wtf = status
	yolo = !git commit -m \"$(curl -s whatthecommit.com/index.txt)\"
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true
[merge]
{{- if lookPath "nvim" }}
	tool = nvimdiff
{{- else }}
	tool = vimdiff
{{- end }}
[init]
	defaultBranch = main
